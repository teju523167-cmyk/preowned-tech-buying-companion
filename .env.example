# Copy this file to .env and replace every placeholder. Never commit .env.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/preownedTech
SESSION_SECRET=replace_with_at_least_32_random_characters
FRONTEND_ORIGIN=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ATLAS_LISTING_VECTOR_INDEX=listing_vector_index
ATLAS_DOCUMENT_VECTOR_INDEX=document_vector_index

# Set these only while creating the first moderator, then remove them.
BOOTSTRAP_MODERATOR_NAME=Project Moderator
BOOTSTRAP_MODERATOR_EMAIL=moderator@example.com
BOOTSTRAP_MODERATOR_PASSWORD=replace_with_a_unique_password_of_at_least_12_chars

# Set this to seed reproducible local demo accounts and listings.
DEMO_PASSWORD=replace_with_a_unique_demo_password_of_at_least_12_chars
